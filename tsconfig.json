{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@cc/schemas/engine/v1": ["./extension-api/v1/engine.ts"],
      "@cc/schemas/engine/v1-tokens": ["./extension-api/v1/tokens.ts"],
      "@cc/ui-sdk/v1": ["./extension-api/v1/ui-sdk.d.ts"]
    }
  },
  "include": ["cc.config.ts", "ui", "extension-api", "tools", "test", "vitest.config.ts"],
  "exclude": ["node_modules", "fixtures"]
}
